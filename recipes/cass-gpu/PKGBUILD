# Built by localbuild from the worktree in $LB_SRCDIR; not for use with plain makepkg.
pkgname=cass-gpu-local
pkgver=$LB_PKGVER
pkgrel=$LB_PKGREL
pkgdesc="cass agent session search (oysteinkrog fork) with CUDA embedding, built by localbuild"
arch=(x86_64)
url="https://github.com/oysteinkrog/coding_agent_session_search"
license=(MIT)
depends=(cuda)
makedepends=(rustup)
provides=(cass)
conflicts=(cass-local)
options=(!lto !debug)

build() {
    cd "$LB_SRCDIR"
    # One target dir per recipe, so builds of nearby commits reuse the final binaries.
    # Intermediate files follow build.build-dir in ~/.cargo/config.toml.
    export CARGO_TARGET_DIR="$HOME/.cache/build/cass-gpu/target"
    export PATH="/opt/cuda/bin:$PATH"
    # candle-kernels compiles PTX for this compute capability (RTX 50 series = 12.0).
    export CUDA_COMPUTE_CAP="${CUDA_COMPUTE_CAP:-120}"
    nice -n 5 cargo build --release --locked --features cuda --bin cass
}

package() {
    install -Dm755 "$HOME/.cache/build/cass-gpu/target/release/cass" "$pkgdir/usr/bin/cass"
    install -Dm644 "$LB_SRCDIR/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
