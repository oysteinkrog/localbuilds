From ab8bf63b901a0785be148a4265e697e586f73e59 Mon Sep 17 00:00:00 2001
From: localbuild <localbuild@localhost>
Date: Tue, 20 Oct 2026 18:44:26 +0200
Subject: [PATCH] plugin: keep C++ ownership of the shared QML singletons

ShaderLibrarySingleton and PlmGreeterSetupSingleton hand out one object to
every QML engine in plasmashell, but the engine takes ownership of an object
returned from a singleton callback. When the first engine that asked for it
is destroyed, the shared ShaderLibrary is deleted. Every wallpaper created
after that sees a null singleton ("toRelativeShaderPath is not a function"
in ShaderSystem.qml) and shows the default PS3_MenuColor shader instead of
the selected one. Mark both objects CppOwnership.

Upstream-Status: local-only
---
 src/plugin/shaderwallpaperplugin.cpp | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/src/plugin/shaderwallpaperplugin.cpp b/src/plugin/shaderwallpaperplugin.cpp
index bd074bc..308f838 100644
--- a/src/plugin/shaderwallpaperplugin.cpp
+++ b/src/plugin/shaderwallpaperplugin.cpp
@@ -17,6 +17,8 @@
 #include "models/shaderlistmodel.h"
 #include "models/categorymodel.h"
 
+#include <QJSEngine>
+
 void ShaderWallpaperPlugin::registerTypes(const char *uri)
 {
     Q_ASSERT(QLatin1String(uri) == QLatin1String("online.knowmad.shaderwallpaper"));
@@ -49,6 +51,8 @@ void ShaderWallpaperPlugin::registerTypes(const char *uri)
             Q_UNUSED(engine)
             Q_UNUSED(scriptEngine)
             static PlmGreeterSetup instance;
+            // Keep the engine from deleting the static instance.
+            QJSEngine::setObjectOwnership(&instance, QJSEngine::CppOwnership);
             return &instance;
         });
 
@@ -57,7 +61,13 @@ void ShaderWallpaperPlugin::registerTypes(const char *uri)
         [](QQmlEngine *engine, QJSEngine *scriptEngine) -> QObject * {
             Q_UNUSED(engine)
             Q_UNUSED(scriptEngine)
-            return ShaderLibrary::instance();
+            // The instance is shared by every engine in the process. Without
+            // CppOwnership the first engine to be destroyed deletes it, and
+            // later wallpapers see a null singleton and fall back to the
+            // default shader.
+            ShaderLibrary *library = ShaderLibrary::instance();
+            QJSEngine::setObjectOwnership(library, QJSEngine::CppOwnership);
+            return library;
         });
 }
 
