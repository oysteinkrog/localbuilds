# Built by localbuild from the worktree in $LB_SRCDIR; not for use with plain makepkg.
pkgname=cass-local
pkgver=$LB_PKGVER
pkgrel=$LB_PKGREL
pkgdesc="cass agent session search (oysteinkrog fork), built by localbuild"
arch=(x86_64)
url="https://github.com/oysteinkrog/coding_agent_session_search"
license=(MIT)
makedepends=(rustup)
provides=(cass)
options=(!lto !debug)

build() {
    cd "$LB_SRCDIR"
    # One target dir per recipe, so builds of nearby commits reuse compiled crates.
    export CARGO_TARGET_DIR="$HOME/.cache/build/cass/target"
    # ~/.cargo/config.toml puts build.build-dir in the workspace. Each build here runs
    # in a new worktree, so keep the intermediate files in the recipe target dir too.
    export CARGO_BUILD_BUILD_DIR="$CARGO_TARGET_DIR"
    nice -n 5 cargo build --release --locked --bin cass
}

package() {
    install -Dm755 "$HOME/.cache/build/cass/target/release/cass" "$pkgdir/usr/bin/cass"
    install -Dm644 "$LB_SRCDIR/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
