# Built by localbuild from the patched worktree in $LB_SRCDIR; not for use with plain makepkg.
pkgname=frankenterm-local
pkgver=$LB_PKGVER
pkgrel=$LB_PKGREL
pkgdesc="FrankenTerm terminal (oysteinkrog fork), built by localbuild"
arch=(x86_64)
url="https://github.com/oysteinkrog/frankenterm"
license=(MIT)
depends=(fontconfig libxkbcommon wayland)
makedepends=(rustup)
provides=(frankenterm)
# !strip keeps the line tables of the release-local profile, so perf can name functions.
options=(!lto !debug !strip)

build() {
    cd "$LB_SRCDIR"
    # One target dir per recipe, so builds of nearby commits reuse compiled crates.
    export CARGO_TARGET_DIR="$HOME/.cache/build/frankenterm/target"
    # ~/.cargo/config.toml puts build.build-dir in the workspace. Each build here runs
    # in a new worktree, so keep the intermediate files in the recipe target dir too.
    export CARGO_BUILD_BUILD_DIR="$CARGO_TARGET_DIR"
    # release-local: release-interactive (opt-level 3) plus line tables, defined on the fork.
    # wayland: the GUI talks to the compositor directly instead of through XWayland.
    cargo build --profile release-local --locked -p frankenterm-gui -p frankenterm-mux-server \
        --features frankenterm-gui/wayland
}

package() {
    local t="$HOME/.cache/build/frankenterm/target/release-local"
    install -Dm755 "$t/frankenterm-gui" "$pkgdir/usr/bin/frankenterm-gui"
    install -Dm755 "$t/frankenterm-mux-server" "$pkgdir/usr/bin/frankenterm-mux-server"
    install -Dm644 "$LB_SRCDIR/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    # The icon is named after the app ID, which is also the window class, the desktop
    # file name and the icon the notifications ask for. Fork commits before fa830779
    # have no SVG.
    local icon="$LB_SRCDIR/assets/icon/terminal.svg"
    if [ -f "$icon" ]; then
        install -Dm644 "$icon" \
            "$pkgdir/usr/share/icons/hicolor/scalable/apps/com.dicklesworthstone.frankenterm.svg"
    fi
}
