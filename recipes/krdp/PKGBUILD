# Built by localbuild from the fork worktree in $LB_SRCDIR; not for use with plain makepkg.
# Build steps follow the Arch krdp PKGBUILD. KPipeWire and FreeRDP come from /opt/krdp-local.
pkgname=krdp-local
pkgver=$LB_PKGVER
pkgrel=$LB_PKGREL
pkgdesc="KRDP master with audio and microphone redirection (oysteinkrog fork), built by localbuild"
arch=(x86_64)
url="https://github.com/oysteinkrog/krdp"
license=(LGPL-2.0-or-later)
depends=(freerdp-krdp-local glibc kcmutils kconfig kcoreaddons kcrash kdbusaddons kguiaddons ki18n kirigami-addons
         kpipewire-krdp-local kstatusnotifieritem libpipewire libstdc++ libxkbcommon pam qt6-base
         qtkeychain-qt6 systemd-libs wayland ffmpeg libdrm libepoxy mesa)
# cuda: only the driver API headers, for the GPU encode path; libcuda is loaded at run time.
makedepends=(extra-cmake-modules plasma-wayland-protocols cuda)
provides=(krdp)
conflicts=(krdp)
options=(!debug)

build() {
    cmake -B build -S "$LB_SRCDIR" -G Ninja \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_PREFIX_PATH=/opt/krdp-local \
        -DCMAKE_INSTALL_RPATH=/opt/krdp-local/lib \
        -DBUILD_TESTING=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
