From 5ff8a8780fef981b1e7eee820f4f07125bc658e9 Mon Sep 17 00:00:00 2001
From: localbuild <localbuild@localhost>
Date: Thu, 12 Nov 2026 08:17:07 +0100
Subject: [PATCH] relax-compiler: promote &Ctor of a drop-free value, set
 CARGO_MANIFEST_LINKS


Two fixes found while running the Initial Force analysis crates under Relax.

1. `&E::B` where E has drop glue (enum E { B, S(String) }) was lowered as a stack
   temporary, so a function returning it handed back a dangling reference. rustc
   qualifies promotion candidates by value: a unit variant, or a ctor of promotable
   operands, of an ADT without a Drop impl, is promoted to a 'static. Without this,
   sc-model's unit tests segfaulted in Arc::clone and a small repro printed garbage.

2. cargo sets CARGO_MANIFEST_LINKS for a package that declares `links`. Relax did not,
   so prettyplease 0.3's build script failed and no test of sc-proto could start.

Upstream-Status: local-only
---
 libs/relax/base/src/resolve.rs   |  5 +++++
 libs/relax/compiler/src/lower.rs | 24 +++++++++++++++++++++++-
 2 files changed, 28 insertions(+), 1 deletion(-)

diff --git a/libs/relax/base/src/resolve.rs b/libs/relax/base/src/resolve.rs
index df56d10a..a34c1134 100644
--- a/libs/relax/base/src/resolve.rs
+++ b/libs/relax/base/src/resolve.rs
@@ -2093,6 +2093,11 @@ pub fn package_meta_env(dir: &str) -> Vec<(String, String)> {
         };
         out.push((env.to_string(), text));
     }
+    // cargo sets CARGO_MANIFEST_LINKS when the package declares `links`; build scripts such as
+    // prettyplease's read it with env::var and fail without it.
+    if let Some(Toml::Str(l, _)) = pkg.get("links") {
+        out.push(("CARGO_MANIFEST_LINKS".to_string(), l.clone()));
+    }
     out
 }
 
diff --git a/libs/relax/compiler/src/lower.rs b/libs/relax/compiler/src/lower.rs
index 1d1db5fa..6236648e 100644
--- a/libs/relax/compiler/src/lower.rs
+++ b/libs/relax/compiler/src/lower.rs
@@ -5891,7 +5891,7 @@ impl<'a> Lcx<'a> {
         if self.unsized_ty(t) { return false; }
         if self.u.tcx.needs_drop(&self.u.prog, crate::tcx::TypingEnv::fully_monomorphized(&self.u.prog), t)
             || !self.u.tcx.is_freeze(&self.u.prog, crate::tcx::TypingEnv::fully_monomorphized(&self.u.prog), t) {
-            return self.const_promotable(e);
+            return self.const_promotable(e) || self.drop_free_ctor_promotable(e, t);
         }
         let ast = self.ast();
         match ast.expr(e).kind.clone() {
@@ -5963,6 +5963,28 @@ impl<'a> Lcx<'a> {
     }
 
 
+    /// rustc qualifies a promotion candidate by its value, not its type
+    /// (rustc_const_eval/src/check_consts/qualifs.rs, in_rvalue for an Aggregate): a unit
+    /// variant, or a variant or struct built from operands that are themselves promotable,
+    /// of an ADT without a Drop impl, needs no drop even when its type does. So
+    /// `&E::B` with `enum E { B, S(String) }` is a 'static, not a stack temporary.
+    /// The type must still be Freeze: interior mutability stays type-based here.
+    fn drop_free_ctor_promotable(&mut self, e: ExprId, t: TyId) -> bool {
+        if self.u.tcx.has_drop_impl(t)
+            || !self.u.tcx.is_freeze(&self.u.prog, crate::tcx::TypingEnv::fully_monomorphized(&self.u.prog), t) {
+            return false;
+        }
+        let ast = self.ast();
+        let is_ctor = |s: &Self, x: ExprId| matches!(s.b.res.get(&strip_paren(s.ast(), x).0), Some(Res::Def(d)) if matches!(s.u.prog.def(*d).kind, DefKind::Variant | DefKind::Struct));
+        match ast.expr(e).kind.clone() {
+            ExprKind::Paren(x) => self.promotable(x),
+            ExprKind::Path(_) => is_ctor(self, e),
+            ExprKind::Call(f, args) => is_ctor(self, f) && ast.list(args).iter().all(|x| self.promotable(*x)),
+            ExprKind::Struct(row) if ast.row(row).base == crate::ast::OptExprId::NONE && !ast.row(row).rest => ast.list(ast.row(row).fields).iter().all(|f| self.promotable(f.expr)),
+            _ => false,
+        }
+    }
+
     /// The value of the promotable integer operand `x` (rustc promote_consts: try_eval_scalar
     /// of a division's constant operand), sign-extended; None when it cannot be evaluated here.
     fn promoted_int(&mut self, x: ExprId) -> Option<i128> {
-- 
