# Built by localbuild from the fork worktree in $LB_SRCDIR; not for use with plain makepkg.
# Build steps and depends copied from the Arch plasma-desktop 6.8.2 PKGBUILD.
pkgname=plasma-desktop-local
pkgver=$LB_PKGVER
pkgrel=$LB_PKGREL
pkgdesc="KDE Plasma Desktop 6.8.2 with a setting to turn off the lock screen blur (oysteinkrog fork), built by localbuild"
arch=(x86_64)
url="https://github.com/oysteinkrog/plasma-desktop"
license=(LGPL-2.0-or-later)
depends=(attica baloo emoji-font glibc kbookmarks kcmutils kcodecs kcompletion kconfig
         kconfigwidgets kcoreaddons kcrash kdbusaddons kdeclarative kglobalaccel kguiaddons
         ki18n kiconthemes kio kirigami kirigami-addons kitemmodels kjobwidgets kmenuedit
         knewstuff knotifications knotifyconfig kpackage kpipewire krunner kscreenlocker
         kservice ksvg kwidgetsaddons kwindowsystem kxmlgui libcanberra libksysguard
         libstdc++ libwacom libx11 libxcb libxkbcommon libxkbfile libplasma
         plasma-activities plasma-activities-stats plasma-workspace plasma5support
         polkit-kde-agent powerdevil qt6-5compat qt6-base qt6-declarative sdl2 solid sonnet
         systemd-libs systemsettings wayland xcb-util-keysyms xdg-user-dirs)
optdepends=('bluedevil: Bluetooth applet'
            'glib2: kimpanel IBUS support'
            'ibus: kimpanel IBUS support'
            'kaccounts-integration: OpenDesktop integration plugin'
            'kscreen: screen management'
            'libaccounts-qt: OpenDesktop integration plugin'
            'packagekit-qt6: to install new krunner plugins'
            'plasma-nm: Network manager applet'
            'plasma-pa: Audio volume applet'
            'scim: kimpanel SCIM support')
makedepends=(extra-cmake-modules intltool kaccounts-integration kdoctools libibus
             packagekit-qt6 scim wayland-protocols)
provides=(plasma-desktop=6.8.2)
conflicts=(plasma-desktop)
groups=(plasma)
options=(!debug)

build() {
    cmake -B build -S "$LB_SRCDIR" -G Ninja \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DKDE_INSTALL_LIBEXECDIR=lib \
        -DBUILD_TESTING=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
