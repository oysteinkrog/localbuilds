# Built by localbuild from the fork worktree in $LB_SRCDIR; not for use with plain makepkg.
# Build steps and depends copied from the Arch powerdevil 6.8.1 PKGBUILD.
pkgname=powerdevil-local
pkgver=$LB_PKGVER
pkgrel=$LB_PKGREL
pkgdesc="Powerdevil 6.8.1 with local fixes (oysteinkrog fork), built by localbuild"
arch=(x86_64)
url="https://github.com/oysteinkrog/powerdevil"
license=(LGPL-2.0-or-later)
depends=(ddcutil
         glibc
         plasma-activities
         kauth
         kcmutils
         kconfig
         kcoreaddons
         kcrash
         kdbusaddons
         kglobalaccel
         ki18n
         kidletime
         kirigami
         kitemmodels
         knotifications
         kpackage
         kservice
         kxmlgui
         libkscreen
         libplasma
         libstdc++
         plasma-workspace
         qcoro
         qt6-base
         qt6-declarative
         solid
         systemd-libs
         wayland)
makedepends=(extra-cmake-modules kdoctools plasma-wayland-protocols)
optdepends=('kinfocenter: for the Energy Information KCM'
            'power-profiles-daemon: power profiles support'
            'tlp: alternative power profiles support')
provides=(powerdevil=6.8.1)
conflicts=(powerdevil)
options=(!debug)

build() {
    cmake -B build -S "$LB_SRCDIR" -G Ninja \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DKDE_INSTALL_LIBEXECDIR=lib \
        -DBUILD_TESTING=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
