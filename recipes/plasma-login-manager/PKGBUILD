# Built by localbuild from the fork worktree in $LB_SRCDIR; not for use with plain makepkg.
# Build steps and depends copied from the Arch plasma-login-manager 6.8.2 PKGBUILD.
pkgname=plasma-login-manager-local
pkgver=$LB_PKGVER
pkgrel=$LB_PKGREL
pkgdesc="Plasma Login Manager 6.8.2 with a setting to turn off the wallpaper blur (oysteinkrog fork), built by localbuild"
arch=(x86_64)
url="https://github.com/oysteinkrog/plasma-login-manager"
license=(GPL-2.0-or-later)
depends=(glibc
         kauth
         kcmutils
         kconfig
         kcoreaddons
         kdbusaddons
         ki18n
         kio
         kirigami
         kpackage
         kservice
         layer-shell-qt
         libkscreen
         libplasma
         libstdc++
         libxau
         pam
         plasma-workspace
         qt6-5compat
         qt6-base
         qt6-declarative
         sh
         systemd-libs)
makedepends=(extra-cmake-modules qt6-tools)
provides=(plasma-login-manager=6.8.2)
conflicts=(plasma-login-manager)
options=(!debug)

build() {
    cmake -B build -S "$LB_SRCDIR" -G Ninja \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DKDE_INSTALL_LIBEXECDIR=lib \
        -DBUILD_TESTING=OFF \
        -DDBUS_CONFIG_FILENAME=plasma_org.freedesktop.DisplayManager.conf
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
